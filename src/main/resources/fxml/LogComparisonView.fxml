<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.logviewpro.controller.LogComparisonController">
    <!-- Comparison Control Bar -->
    <VBox spacing="10.0" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label style="-fx-font-weight: bold;" text="File A:" />
            <ComboBox fx:id="comboFileA" prefWidth="300.0" />
            <Label style="-fx-font-weight: bold;" text="File B:" />
            <ComboBox fx:id="comboFileB" prefWidth="300.0" />
            <CheckBox fx:id="chkIgnoreTimestamps" selected="true" text="Ignore Timestamps" />
            <Button fx:id="btnCompare" onAction="#onCompare" styleClass="button-primary" text="⚖ Run Comparison" />
            <Button fx:id="btnExportDiff" disable="true" onAction="#onExportDiff" styleClass="button-secondary" text="📄 Export Diff Report" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="24.0" style="-fx-padding: 4 0;">
            <Label fx:id="lblStatsA" style="-fx-text-fill: -color-text-muted;" text="File A: 0 entries" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="lblStatsB" style="-fx-text-fill: -color-text-muted;" text="File B: 0 entries" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="lblDiffSummary" style="-fx-text-fill: #38BDF8; -fx-font-weight: bold;" text="Identical: 0 | Added: 0 | Removed: 0" />
        </HBox>
    </VBox>

    <!-- Diff Entries Table -->
    <TableView fx:id="tableDiff" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDiffType" prefWidth="95.0" text="Diff Status" />
            <TableColumn fx:id="colDiffDesc" prefWidth="180.0" text="Comparison Note" />
            <TableColumn fx:id="colMessageA" prefWidth="480.0" text="Log Entry (File A)" />
            <TableColumn fx:id="colMessageB" prefWidth="480.0" text="Log Entry (File B)" />
        </columns>
    </TableView>
</VBox>
